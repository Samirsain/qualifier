DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threepct?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
AUTOMATION_TICK_SECRET="replace-with-a-random-secret"

# WhatsApp — "mock" runs without a provider; "meta" talks to the Cloud API.
WHATSAPP_PROVIDER="mock"
# Any string you choose; the same one goes in Meta's webhook panel.
WHATSAPP_VERIFY_TOKEN="dev-verify-token"
# System-user token (permanent). Meta > Business settings > Users > System users
WHATSAPP_ACCESS_TOKEN=""
# Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Meta > App settings > Basic > App secret. Without it every inbound reply is rejected.
WHATSAPP_APP_SECRET=""

# First administrator, created by `npm run db:seed`.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# 102 invented demo numbers for empty screens — development only.
# SEED_DEMO="true"
