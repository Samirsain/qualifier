// 3% Club — WhatsApp qualification filter.
// Upload numbers, run them through a funnel, export the ones who ask to be
// contacted. Everything the full CRM needed to track staff, leads, campaigns
// and scoring is gone; the CRM team works outside this system.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums (only where the source defines a closed list) ----------

enum RoleCode {
  ADMIN
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// The five states a number can be in.
enum CustomerStatus {
  NOT_STARTED
  IN_FUNNEL
  QUALIFIED
  NOT_INTERESTED
  NO_RESPONSE
}

enum BatchStatus {
  DRAFT
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

/// README: Automation statuses
enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  INTERACTIVE
  MEDIA
  SYSTEM
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AutomationType {
  INTRODUCTION
  YES_NO_BRANCH
  REVISION
  NO_RESPONSE_FOLLOW_UP
  FAQ
  HANDOFF
  CUSTOM
}

enum StepType {
  TRIGGER
  CONDITION
  ACTION
  WAIT
  BRANCH
}

enum RunState {
  RUNNING
  WAITING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

// ---------- identity & access ----------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  externalSubject String?    @unique
  displayName     String
  role            RoleCode   @default(VIEWER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notifications      Notification[]
  activityLogs       ActivityLog[]
  automationsCreated Automation[]
  batchesCreated     Batch[]

  @@index([status])
  @@map("users")
}

// ---------- batches & customers ----------

model Batch {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  automationId      String      @db.Uuid
  automationVersion Int
  status            BatchStatus @default(DRAFT)
  createdById       String      @db.Uuid
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  automation Automation    @relation(fields: [automationId], references: [id])
  createdBy  User          @relation(fields: [createdById], references: [id])
  members    BatchMember[]
  customers  Customer[]

  @@index([status, createdAt])
  @@map("batches")
}

model BatchMember {
  batchId       String    @db.Uuid
  customerId    String    @db.Uuid
  enrolledAt    DateTime?
  skippedReason String?

  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([batchId, customerId])
  @@index([batchId, enrolledAt])
  @@map("batch_members")
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  name              String?
  phoneE164         String         @unique
  email             String?
  location          String?
  status            CustomerStatus @default(NOT_STARTED)
  batchId           String?        @db.Uuid
  optedOutAt        DateTime?
  lastInteractionAt DateTime?
  qualifiedAt       DateTime?
  exportedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  batch         Batch?             @relation(fields: [batchId], references: [id])
  batchMembers  BatchMember[]
  conversations Conversation[]
  messages      Message[]
  responses     CustomerResponse[]
  runs          AutomationRun[]
  activityLogs  ActivityLog[]

  @@index([status])
  @@index([qualifiedAt])
  @@index([batchId])
  @@index([exportedAt])
  @@map("customers")
}

// ---------- conversations & messages ----------

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @db.Uuid
  channel       String             @default("whatsapp")
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  unreadCount   Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([status, lastMessageAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  customerId        String           @db.Uuid
  providerMessageId String?          @unique
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  templateId        String?          @db.Uuid
  body              String?
  payload           Json?
  deliveryStatus    DeliveryStatus   @default(QUEUED)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureCode       String?
  createdAt         DateTime         @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template     Template?          @relation(fields: [templateId], references: [id])
  responses    CustomerResponse[]

  @@index([conversationId, createdAt])
  @@index([customerId, createdAt])
  @@index([deliveryStatus])
  @@map("messages")
}

// ---------- templates ----------

model Template {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @unique
  category            String
  providerTemplateKey String?
  language            String?
  approvalStatus      String?
  body                String
  structure           Json?
  active              Boolean   @default(true)
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  messages Message[]

  @@index([category])
  @@index([active])
  @@map("templates")
}

// ---------- automation ----------

model Automation {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  type            AutomationType
  status          AutomationStatus @default(DRAFT)
  version         Int              @default(1)
  description     String?
  entryConditions Json?
  createdById     String           @db.Uuid
  activatedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy User             @relation(fields: [createdById], references: [id])
  steps     AutomationStep[]
  runs      AutomationRun[]
  batches   Batch[]

  @@index([status])
  @@index([type])
  @@map("automations")
}

model AutomationStep {
  id           String   @id @default(uuid()) @db.Uuid
  automationId String   @db.Uuid
  version      Int      @default(1)
  stepKey      String
  stepType     StepType
  config       Json
  nextStepKey  String?
  branchMap    Json?
  sortOrder    Int      @default(0)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, version, stepKey])
  @@index([automationId, sortOrder])
  @@map("automation_steps")
}

model AutomationRun {
  id                String    @id @default(uuid()) @db.Uuid
  automationId      String    @db.Uuid
  automationVersion Int
  customerId        String    @db.Uuid
  state             RunState  @default(RUNNING)
  currentStepKey    String?
  enteredAt         DateTime  @default(now())
  nextActionAt      DateTime?
  pausedAt          DateTime?
  pauseRemainingMs  Int?
  stoppedAt         DateTime?
  stopReason        String?
  completedAt       DateTime?

  automation Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events     AutomationEvent[]
  responses  CustomerResponse[]

  // Durable timer queue: the worker claims due rows by (state, nextActionAt).
  @@index([state, nextActionAt])
  @@index([customerId, state])
  @@index([automationId])
  @@map("automation_runs")
}

model AutomationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String   @db.Uuid
  stepKey        String?
  eventType      String
  payload        Json?
  idempotencyKey String?  @unique
  occurredAt     DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, occurredAt])
  @@map("automation_events")
}

model CustomerResponse {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  runId        String?  @db.Uuid
  questionKey  String
  questionText String?
  response     String
  result       String?
  messageId    String?  @db.Uuid
  receivedAt   DateTime @default(now())

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  run      AutomationRun? @relation(fields: [runId], references: [id])
  message  Message?       @relation(fields: [messageId], references: [id])

  @@index([customerId, receivedAt])
  @@map("customer_responses")
}

// ---------- notifications, audit, settings ----------

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  eventType   String
  relatedType String?
  relatedId   String?   @db.Uuid
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  eventType   String
  objectType  String
  objectId    String?
  customerId  String?  @db.Uuid
  before      Json?
  after       Json?
  metadata    Json?
  occurredAt  DateTime @default(now())

  actor    User?     @relation(fields: [actorUserId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([occurredAt])
  @@index([customerId, occurredAt])
  @@index([objectType, objectId])
  @@map("activity_logs")
}

/// Emergency controls (BR-39 / F-022) and business config for resolved
/// decisions: no-response wait, reporting timezone, opt-out keywords.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
